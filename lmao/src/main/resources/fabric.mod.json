{
  "schemaVersion": 1,
  "id": "primeclient",
  "version": "${version}",
  "name": "PrimeClient",
  "description": "PrimeCrasher addon for Meteor Client.",
  "authors": [
   "hieu"
  ],
  "contact": {
    "repo": "https://github.com/Renovsk"
  },
  "icon": "icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.hieu.client.Main"
    ]
  },
  "mixins": [
    "PrimeClient.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "177,205,255"
  },
  "depends": {
    "java": ">=21",
    "minecraft": ["${mc_version}"],
    "meteor-client": "*"
  }
}
